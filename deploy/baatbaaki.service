[Unit]
Description=BaatBaaki Hindi News
After=network.target
[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/baatbaaki/.next/standalone
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
EnvironmentFile=-/var/www/baatbaaki/.env.production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
